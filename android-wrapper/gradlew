DIR=""
case "$0" in
    /*) DIR="${0%/*}" ;;
    */*) DIR="./${0%/*}" ;;
    *) DIR="." ;;
esac

if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
elif [ -f "$DIR/gradle/wrapper/gradle-wrapper.jar" ]; then
    JAVACMD="java"
    if [ -n "$JAVA_HOME" ]; then
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    exec "$JAVACMD" -jar "$DIR/gradle/wrapper/gradle-wrapper.jar" "$@"
else
    echo "Gradle wrapper jar not found and 'gradle' command not in PATH."
    exit 1
fi
